<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- Icono de la aplicación -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:text="💰"
            android:textSize="42sp"
            android:background="#E3EDFF" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="¡Bienvenido!"
            android:textColor="#172B4D"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:text="Inicia sesión para administrar tus gastos"
            android:textColor="#64748B"
            android:textSize="15sp" />

        <!-- Usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Nombre de usuario"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ingresa tu usuario"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#2563EB" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Contraseña"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#2563EB" />

        <!-- Botón de inicio de sesión -->
        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="INICIAR SESIÓN"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB" />

        <!-- Botón de registro -->
        <Button
            android:id="@+id/btnIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="#2563EB"
            android:backgroundTint="#F4F7FC" />

    </LinearLayout>
</ScrollView>
