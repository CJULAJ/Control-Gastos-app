<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Encabezado azul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:background="@drawable/bg_panel_azul">

            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:gravity="center"
                android:text="💰"
                android:textSize="40sp"
                android:background="@drawable/bg_icono_login" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Crear una cuenta"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Comienza a organizar tus finanzas"
                android:textColor="#DCE8FF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Formulario de registro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_tarjeta_gasto">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Únete a Control de Gastos!"
                android:textColor="@color/finance_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Completa tus datos para comenzar"
                android:textColor="@color/finance_secondary_text"
                android:textSize="14sp" />

            <!-- Nombre de usuario -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Nombre de usuario"
                android:textColor="@color/finance_text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegistroUsuario"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo_login"
                android:hint="Elige un nombre de usuario"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/finance_text"
                android:textColorHint="@color/finance_secondary_text" />

            <!-- Contraseña -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Contraseña"
                android:textColor="@color/finance_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo_login"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/etRegistroPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Mínimo 8 caracteres"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text" />

                <TextView
                    android:id="@+id/btnToggleRegistroPassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="👁️"
                    android:textSize="18sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Mostrar u ocultar contraseña" />
            </LinearLayout>

            <!-- Confirmar contraseña -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Confirmar contraseña"
                android:textColor="@color/finance_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo_login"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/etRegistroConfirmarPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Repite tu contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text" />

                <TextView
                    android:id="@+id/btnToggleRegistroConfirmarPassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="👁️"
                    android:textSize="18sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Mostrar u ocultar contraseña" />
            </LinearLayout>

            <!-- Botón para crear cuenta -->
            <Button
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:text="CREAR CUENTA"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB" />

            <!-- Regresar al inicio de sesión -->
            <Button
                android:id="@+id/btnIrLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="¿Ya tienes cuenta? Inicia sesión"
                android:textColor="@color/finance_primary"
                android:backgroundTint="@color/finance_surface" />

        </LinearLayout>

        <!-- Pie de página -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Control de Gastos • Finanzas personales"
            android:textColor="@color/finance_secondary_text"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
