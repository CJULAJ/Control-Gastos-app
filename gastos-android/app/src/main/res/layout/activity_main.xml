<?xml version="1.0" encoding="utf-8"?>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/finance_background">

        <ScrollView
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">


        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_azul"
            android:id="@+id/seccionInicio"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="CONTROL DE GASTOS"
                android:textColor="#C7D9FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSaludoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="¡Bienvenido!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tu dinero, más claro cada día"
                android:textColor="#E2EAFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_tarjeta_gasto"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESUMEN DE GASTOS"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResumen"
                    android:textColor="@color/finance_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cargando resumen..."
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- RESUMEN EN INICIO (Días / Semana) -->
        <LinearLayout
            android:id="@+id/seccionResumenInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- GASTOS DE HOY -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gastado hoy"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGastosHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- GASTOS DE LA SEMANA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Últimos 7 días"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGastosSemana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Registro desplegable -->
        <LinearLayout
            android:id="@+id/seccionAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_gasto"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvToggleRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Abrir o cerrar el formulario para registrar un gasto"
                android:text="＋  Registrar nuevo gasto   ▾"
                android:textColor="@color/finance_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenidoRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Descripción"
                    android:textColor="@color/finance_text"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDescripcion"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:hint="Ej. Almuerzo, transporte..."
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Monto (Q)"
                    android:textColor="#334155"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMonto"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Categoría"
                    android:textColor="#334155"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:paddingHorizontal="12dp" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#2563EB"
                    android:text="GUARDAR GASTO"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filtros desplegables -->
        <LinearLayout
            android:id="@+id/seccionFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tarjeta_gasto"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvToggleFiltros"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Abrir o cerrar los filtros de movimientos"
                android:text="☷  Filtrar movimientos   ▾"
                android:textColor="@color/finance_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenidoFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Categoría"
                    android:textColor="#334155" />

                <Spinner
                    android:id="@+id/spFiltroCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:contentDescription="Filtrar gastos por categoría"
                    android:paddingHorizontal="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Fecha"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/etFiltroFecha"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:hint="AAAA-MM-DD"
                    android:inputType="date"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFiltrar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#2563EB"
                        android:text="FILTRAR"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnMostrarTodos"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:backgroundTint="#64748B"
                        android:text="VER TODOS"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- La gráfica irá aquí en el siguiente paso -->
            <!-- SECCIÓN DATOS -->
            <LinearLayout
                android:id="@+id/seccionDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estadísticas de gastos"
                    android:textColor="@color/finance_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gastos de los últimos 7 días"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTotalSemanal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:id="@+id/contenedorGrafica"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="20dp" />

                </LinearLayout>

            </LinearLayout>

        <!-- Mis movimientos: se conserva el adaptador y sus tarjetas -->
        <LinearLayout
            android:id="@+id/seccionMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_gasto"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mis movimientos"
                android:textColor="@color/finance_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- SECCIÓN PERFIL -->
        <LinearLayout
            android:id="@+id/seccionPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta_gasto"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MI PERFIL"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNombrePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Cargando usuario..."
                    android:textColor="@color/finance_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mi cuenta de Control de Gastos"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta_gasto"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESUMEN DE MIS GASTOS"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResumenPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cargando resumen..."
                    android:textColor="@color/finance_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGastosHoyPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Gastado hoy: Q 0.00"
                    android:textColor="@color/finance_primary"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#B91C1C"
            android:text="CERRAR SESIÓN"
            android:textColor="#FFFFFF" />
    </LinearLayout>

        </ScrollView>

        <!-- Navegación inferior fija -->
        <LinearLayout
            android:id="@+id/barraNavegacion"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:background="@color/finance_surface"
            android:elevation="8dp">

            <TextView
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂&#10;Inicio"
                android:textColor="@color/finance_primary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navGastos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☷&#10;Gastos"
                android:textColor="@color/finance_secondary_text"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navAgregar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="＋&#10;Agregar"
                android:textColor="@color/finance_secondary_text"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navDatos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▥&#10;Datos"
                android:textColor="@color/finance_secondary_text"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙&#10;Perfil"
                android:textColor="@color/finance_secondary_text"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>


