<?xml version="1.0" encoding="utf-8"?>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/finance_background">

        <ScrollView
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp"
            android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_azul"
            android:id="@+id/seccionInicio"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="CONTROL DE GASTOS"
                android:textColor="#C7D9FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSaludoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="¡Bienvenido!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tu dinero, más claro cada día"
                android:textColor="#E2EAFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_tarjeta_gasto"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESUMEN DE GASTOS"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResumen"
                    android:textColor="@color/finance_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cargando resumen..."
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- RESUMEN EN INICIO (Días / Semana) -->
        <LinearLayout
            android:id="@+id/seccionResumenInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- GASTOS DE HOY -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gastado hoy"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGastosHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- GASTOS DE LA SEMANA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Últimos 7 días"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGastosSemana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Registro desplegable -->
        <LinearLayout
            android:id="@+id/seccionAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_gasto"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvToggleRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Abrir o cerrar el formulario para registrar un gasto"
                android:text="＋  Registrar nuevo gasto   ▾"
                android:textColor="@color/finance_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenidoRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Descripción"
                    android:textColor="@color/finance_text"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDescripcion"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:hint="Ej. Almuerzo, transporte..."
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Monto (Q)"
                    android:textColor="@color/finance_text"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMonto"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="14dp" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Categoría"
                    android:textColor="@color/finance_text"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:paddingHorizontal="12dp" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#2563EB"
                    android:text="GUARDAR GASTO"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filtros desplegables -->
        <LinearLayout
            android:id="@+id/seccionFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tarjeta_gasto"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvToggleFiltros"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Abrir o cerrar los filtros de movimientos"
                android:text="☷  Filtrar movimientos   ▾"
                android:textColor="@color/finance_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenidoFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Categoría"
                    android:textColor="#334155" />

                <Spinner
                    android:id="@+id/spFiltroCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:contentDescription="Filtrar gastos por categoría"
                    android:paddingHorizontal="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Fecha"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/etFiltroFecha"
                    android:textColor="@color/finance_text"
                    android:textColorHint="@color/finance_secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_login"
                    android:hint="AAAA-MM-DD"
                    android:inputType="date"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFiltrar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#2563EB"
                        android:text="FILTRAR"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnMostrarTodos"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:backgroundTint="#64748B"
                        android:text="VER TODOS"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN DATOS / ESTADÍSTICAS -->
        <LinearLayout
            android:id="@+id/seccionDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estadísticas de gastos"
                android:textColor="@color/finance_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Tarjeta de Gráfica Semanal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta_gasto"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GASTOS DE LOS ÚLTIMOS 7 DÍAS"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvTotalSemanal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPromedioDiario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promedio: Q 0.00/día"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDiaMaximo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Día de mayor gasto: -"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="12sp" />

                <!-- Contenedor de las 7 barras -->
                <LinearLayout
                    android:id="@+id/contenedorGrafica"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="20dp" />

            </LinearLayout>

            <!-- Tarjeta de Desglose por Categoría -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta_gasto"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GASTOS POR CATEGORÍA"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/contenedorCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Mis movimientos: se conserva el adaptador y sus tarjetas -->
        <LinearLayout
            android:id="@+id/seccionMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_gasto"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mis movimientos"
                android:textColor="@color/finance_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- SECCIÓN PERFIL PROFESIONAL -->
        <LinearLayout
            android:id="@+id/seccionPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Tarjeta de Encabezado / Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_panel_azul"
                android:padding="24dp">

                <!-- Avatar Circular -->
                <TextView
                    android:id="@+id/tvAvatarPerfil"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_icono_login" />

                <TextView
                    android:id="@+id/tvNombrePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Usuario"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUsuarioTagPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cuenta Personal • Activa"
                    android:textColor="#DCE8FF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Resumen Estadístico del Usuario (3 Tarjetas) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Total Gastado -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total gastado"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvResumenPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Total Movimientos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Movimientos"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalMovimientosPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 registros"
                        android:textColor="@color/finance_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Gastado Hoy -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tarjeta_gasto"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gastado hoy"
                        android:textColor="@color/finance_secondary_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvGastosHoyPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Q 0.00"
                        android:textColor="@color/finance_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Tarjeta de Detalles de Seguridad de Cuenta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_tarjeta_gasto"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INFORMACIÓN Y SEGURIDAD"
                    android:textColor="@color/finance_secondary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cuenta local aislada"
                            android:textColor="@color/finance_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tus registros pertenecen únicamente a tu sesión"
                            android:textColor="@color/finance_secondary_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/finance_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🛡️"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Seguridad de contraseña"
                            android:textColor="@color/finance_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Encriptación con PBKDF2 + Sal aleatoria"
                            android:textColor="@color/finance_secondary_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#B91C1C"
            android:text="CERRAR SESIÓN"
            android:textColor="#FFFFFF" />
    </LinearLayout>

        </ScrollView>

        <!-- BARRA INFERIOR -->
        <LinearLayout
            android:id="@+id/barraNavegacion"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:background="@color/finance_surface"
            android:elevation="8dp">

            <TextView
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableTop="@drawable/ic_nav_inicio"
                android:drawablePadding="5dp"
                android:text="Inicio"
                android:textColor="@color/finance_secondary_text"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/navGastos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableTop="@drawable/ic_nav_gastos"
                android:drawablePadding="5dp"
                android:text="Gastos"
                android:textColor="@color/finance_secondary_text"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/navAgregarIcono"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nav_agregar"
                    android:src="@drawable/ic_nav_agregar_blanco"
