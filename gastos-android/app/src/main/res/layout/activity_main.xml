<?xml version="1.0" encoding="utf-8"?>

<!-- Pantalla principal para registrar y consultar gastos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Campo para escribir la descripción. -->
    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción"
        android:inputType="text" />

    <!-- Campo para ingresar el monto. -->
    <EditText
        android:id="@+id/etMonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monto (Q)"
        android:inputType="numberDecimal" />

    <!-- Permite seleccionar la categoría del gasto. -->
    <Spinner
        android:id="@+id/spCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- Botón para guardar un gasto. -->
    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Guardar" />

    <!-- Muestra el resumen de los gastos. -->
    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="18sp" />

    <!-- Texto que ya existía en la aplicación. -->
    <TextView
        android:id="@+id/tvHolaMundo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="18sp" />

    <!-- Título de la lista de gastos. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Gastos registrados"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Muestra los gastos guardados en una lista desplazable. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGastos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <!-- Permite filtrar los gastos por categoría. -->
    <Spinner
        android:id="@+id/spFiltroCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:contentDescription="Filtrar gastos por categoría" />

    <!-- Permite escribir la fecha que queremos consultar. -->
    <EditText
        android:id="@+id/etFiltroFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:hint="Fecha (AAAA-MM-DD)"
        android:inputType="date"
        android:singleLine="true" />

    <!-- Botones para aplicar o quitar los filtros. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <!-- Aplica los filtros seleccionados. -->
        <Button
            android:id="@+id/btnFiltrar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtrar"
            android:layout_marginEnd="8dp" />

        <!-- Vuelve a mostrar todos los gastos. -->
        <Button
            android:id="@+id/btnMostrarTodos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mostrar todos" />

    </LinearLayout>


</LinearLayout>
