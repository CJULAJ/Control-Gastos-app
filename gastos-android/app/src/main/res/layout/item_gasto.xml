<?xml version="1.0" encoding="utf-8"?>

<!-- Tarjeta de cada gasto registrado -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tarjeta_gasto"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Descripción y monto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDescripcionGasto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Descripción del gasto"
            android:textColor="@color/finance_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMontoGasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q 0.00"
            android:textColor="@color/finance_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Categoría y fecha -->
    <TextView
        android:id="@+id/tvDetalleGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Categoría - Fecha"
        android:textColor="@color/finance_secondary_text"
        android:textSize="14sp" />

    <!-- Línea divisoria -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/finance_border" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditarGasto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="EDITAR"
            android:textColor="#2563EB"
            android:backgroundTint="#EFF6FF" />

        <Button
            android:id="@+id/btnEliminarGasto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="ELIMINAR"
            android:textColor="#DC2626"
            android:backgroundTint="#FEF2F2" />

    </LinearLayout>

</LinearLayout>

